Program        = Package ;

Package        = "package" ID NEWLINE ( Declaration )* ;

Declaration    = UseDecl
               | ExternDecl
               | StructDecl
               | TypeDecl
               | ConstDecl
               | EnumDecl
               | FnDecl
               ;

UseDecl        = "use" [ ID ] STRING NEWLINE ;
ExternDecl     = [ Attributes ] "extern" [ ID ] "{" ( ExternMember )* "}" ;
ExternMember   = [ Attributes ] ( Prototype | OpaqueDecl | StructDecl | UnionDecl | ForeignConst | EnumDecl ) ;
ForeignConst   = "const" ID Type NEWLINE ;
UnionDecl      = "union" ID "{" ( FieldDecl NEWLINE )* "}" NEWLINE ;
OpaqueDecl     = [ Attributes ] "opaque" ID NEWLINE ;
StructDecl     = "struct" ID "{" ( FieldDecl NEWLINE )* "}" NEWLINE ;
TypeDecl       = "type" ID "=" Type NEWLINE ;
ConstDecl      = "const" ID [ Type ] "=" Expr NEWLINE ;
EnumDecl       = "enum" ID [ TypeParams ] [ Type ] "{" NEWLINE ( EnumVariant NEWLINE )* "}" ;
EnumVariant    = [ Attributes ] ID [ "=" Expr ] [ "{" NEWLINE ( FieldDecl NEWLINE )* "}" ] ;
TypeParams     = "<" ID ( "," ID )* ">" ;
FnDecl         = "fn" ID Parameters [ Type ] Block ;

Attributes     = "@[" Attribute ( "," Attribute )* "]" NEWLINE ;
Attribute      = ID "=" STRING ;

Prototype      = "fn" ID Parameters [ Type ] NEWLINE ;
Parameters     = "(" [ Param ( "," Param )* ] ")" ;
Param          = ID ( "@c" "..." | [ "..." ] Type ) ;

FieldDecl      = ID Type ;

Type           = TypeAtom ( SequenceSuffix )* ;
TypeAtom       = BasicType
               | PointerType
               | IdType
                | TupleType
                | FunctionType
                ;
SequenceSuffix = "[" [ INT ] "]" ;

BasicType      = "bool" | "rawptr" | "string" | "cstring"
               | ( "i" | "u" ) ( "8" | "16" | "32" | "64" | "128" )
               | "f" ( "32" | "64" )
               | "int" | "uint" | "float" | "void"
               ;

PointerType    = [ "const" ] "*" Type | "const" "cstring" ;
FunctionType   = "fn" Parameters [ Type ] ;
IdType         = ID [ "::" ID ] [ TypeArgs ] ;
TypeArgs       = "<" Type ( "," Type )* ">" ;
TupleType      = "(" Type ( "," Type )* ")" ;

Block          = "{" ( Statement )* "}" ;
Statement      = ReturnStmt
               | YieldStmt
               | ConstDecl
               | VarStmt
               | IfStmt
               | ForStmt
               | WhileStmt
               | DeferStmt
               | ExprStmt
               ;

ReturnStmt     = "return" [ Expr ] NEWLINE ;
YieldStmt      = "yield" Expr NEWLINE ;
VarStmt        = ( ID | ( "*" )+ ID ) ( "," ( ID | ( "*" )+ ID ) )* 
                 [ ":" Type ] ( ":=" | "=" ) Expr NEWLINE ;
IfStmt         = "if" Expr Block ( "elif" Expr Block )* [ "else" Block ] ;
ForStmt        = "for" ( VarStmt ";" Expr ";" VarStmt | ID "in" Expr ) Block ;
WhileStmt      = "while" Expr Block ;
DeferStmt      = "defer" Statement ;
ExprStmt       = Expr NEWLINE ;

Expr           = LogicalExpr ;
LogicalExpr    = LogicalAndExpr ( "or" LogicalAndExpr )* ;
LogicalAndExpr = ComparisonExpr ( "and" ComparisonExpr )* ;
ComparisonExpr = BitwiseOrExpr [ ( "==" | "!=" | ">" | ">=" | "<" | "<=" ) BitwiseOrExpr ] ;
BitwiseOrExpr  = BitwiseXorExpr ( "|" BitwiseXorExpr )* ;
BitwiseXorExpr = BitwiseAndExpr ( "^" BitwiseAndExpr )* ;
BitwiseAndExpr = ShiftExpr ( "&" ShiftExpr )* ;
ShiftExpr      = Term ( ( "<<" | ">>" ) Term )* ;
Term           = Factor [ ( "+" | "-" ) Factor ] ;
Factor         = UnaryExpr [ ( "*" | "/" ) UnaryExpr ] ;
UnaryExpr      = [ "not" | "~" | "-" | "&" | "*" ] PrimaryExpr ;
PrimaryExpr    = AtomExpr ( IndexSuffix | SliceSuffix )* ;
AtomExpr       = Literal
               | ID
               | "(" Expr ")"
               | FnCall
               | FieldAccess
               | NamespaceAccess
                | StructLiteral
               | ArrayLiteral
               | MatchExpr
                ;

IndexSuffix    = "[" Expr "]" ;
SliceSuffix    = "[" [ Expr ] ":" [ Expr ] "]" [ "@" ID [ Block ] ] ;
ArrayLiteral   = "." "{" [ Expr ( "," Expr )* [ "," ] ] "}" ;

Literal        = INT | FLOAT | STRING | "true" | "false" | "nil" ;
FnCall         = ID "(" [ Expr ( "," Expr )* ] ")" [ "@" ID [ Block ] ] ;
FieldAccess    = ID ( "." ID )+ ;
NamespaceAccess= ID ( "::" ID )+ ;
StructLiteral  = ID "." "{" [ FieldAssign ( "," FieldAssign )* ] "}" ;
FieldAssign    = ID ":" Expr ;
MatchExpr      = "match" Expr "{" NEWLINE ( MatchArm NEWLINE )* "}" ;
MatchArm       = ( "_" | IdType "::" ID [ PayloadPattern ] ) "=>" ( Expr | Block ) ;
PayloadPattern = "." "{" [ PatternField ( "," PatternField )* [ "," ".." ] | ".." ] "}" ;
PatternField   = ID [ ":" ID ] ;
